<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Custom Lookup</masterLabel>
    <description>A reusable record lookup for a configurable Salesforce object.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property
                name="objectApiName"
                type="String"
                label="Object API Name"
                required="true"
            />
            <property name="label" type="String" label="Label" default="Search Records" />
            <property
                name="placeholder"
                type="String"
                label="Placeholder"
                default="Search..."
            />
            <property name="required" type="Boolean" label="Required" default="false" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>